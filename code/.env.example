# =============================================================================
# Onboarding Digital Coworker - environment variables
# Copy this file to `code/.env` and fill in the values. Never commit `.env`.
# Values marked "mock" run the demo with synthetic data and no real systems.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_ENV=local                     # local | demo
LOG_LEVEL=info                    # debug | info | warn | error
WEB_APP_PORT=3000                 # local web app (chat, approval, status views)
ORCHESTRATOR_PORT=8080            # orchestrator API used by the web app

# -----------------------------------------------------------------------------
# Velocity 2.0 (mandatory platform) - confirm names with the Velocity team
# -----------------------------------------------------------------------------
VELOCITY_BASE_URL=
VELOCITY_API_KEY=
VELOCITY_PROJECT_ID=

# -----------------------------------------------------------------------------
# Models (only if Velocity does not proxy model access)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
MODEL_AGENTS=claude-sonnet-5-5    # orchestrator and reasoning agents
MODEL_EXTRACTION=claude-haiku-5-5 # field extraction (lower cost)
MODEL_MONTHLY_BUDGET_USD=300      # usage is logged per run and checked against this

# -----------------------------------------------------------------------------
# Database (cases, packages, approvals, rules, knowledge, audit log)
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/onboarding.db
SEED_DATA_PATH=./data/seed        # rules catalog and synthetic scenarios

# -----------------------------------------------------------------------------
# JobDiva - mock by default; sandbox is READ-ONLY and needs API credentials
# (Client ID from JobDiva support + dedicated API user). The web login does
# not work for the API.
# -----------------------------------------------------------------------------
JOBDIVA_MODE=mock                 # mock | sandbox
JOBDIVA_MOCK_URL=http://localhost:8101
JOBDIVA_BASE_URL=https://api.jobdiva.com   # API host, not login.jobdiva.com
JOBDIVA_CLIENT_ID=
JOBDIVA_API_USER=
JOBDIVA_API_PASSWORD=

# -----------------------------------------------------------------------------
# Onboarding mailbox (start emails) - mock reads synthetic .eml files
# -----------------------------------------------------------------------------
MAILBOX_MODE=mock                 # mock | graph
MAILBOX_MOCK_PATH=./data/mailbox
MAILBOX_ADDRESS=                  # graph mode only (pilot)

# -----------------------------------------------------------------------------
# Microsoft 365 / Teams - OPTIONAL, only if tenant permissions are obtained
# -----------------------------------------------------------------------------
TEAMS_MODE=mock                   # mock | bot
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_PASSWORD=

# -----------------------------------------------------------------------------
# Simulated enterprise services (MCP servers) - never real orders or access
# -----------------------------------------------------------------------------
IT_ACCESS_MOCK_URL=http://localhost:8102      # email, Teams and app access requests
EQUIPMENT_MOCK_URL=http://localhost:8103      # laptop requests (Chelsea Tech), IT approval
PAYROLL_MOCK_URL=http://localhost:8104        # payroll package and returns (Paychex)
LDC_TRACKER_MOCK_URL=http://localhost:8105    # IGS / LDC tracker (SharePoint list)

# -----------------------------------------------------------------------------
# Governance
# -----------------------------------------------------------------------------
APPROVER_NAME="Tonya Ramirez"     # Consultant Onboarding Supervisor (demo approver)
AUDIT_LOG_PATH=./data/audit
REMINDER_MAX_PER_DAY=2            # cap on reminders to candidates or leaders

# -----------------------------------------------------------------------------
# Feature flags (Should / Could capabilities)
# -----------------------------------------------------------------------------
FEATURE_ACCESS_EQUIPMENT=false    # S1
FEATURE_CANDIDATE_FOLLOWUP=false  # S2, S3
FEATURE_PAYROLL_PACKAGE=false     # S4
FEATURE_KNOWLEDGE_BASE=false      # S5
FEATURE_IGS_HANDOFF=false         # C1, C2
