# =============================================================================
# Onboarding Digital Coworker - environment variables
# Copy this file to `code/.env` and fill in the values. Never commit `.env`.
# Values marked "mock" run the demo with synthetic data and no real systems.
# Every service binds to 127.0.0.1 only. See the tech doc, Section 4.3.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_ENV=local                     # local | demo
LOG_LEVEL=info                    # debug | info | warn | error
WEB_APP_PORT=3000                 # local web app and API (chat, inbox, approval, alerts, status views)
ORCHESTRATOR_PORT=8080            # orchestrator endpoint used by the web app
AGENT_TRANSPORT=mcp               # mcp (agents call the MCP servers) | in_process (fallback, same interfaces)

# -----------------------------------------------------------------------------
# Velocity 2.0 (mandatory platform) - confirm names with the Velocity team
# -----------------------------------------------------------------------------
VELOCITY_BASE_URL=
VELOCITY_API_KEY=
VELOCITY_PROJECT_ID=

# -----------------------------------------------------------------------------
# Models - models per agent still to be confirmed (STACK-006)
# -----------------------------------------------------------------------------
MODEL_PROVIDER=rules              # rules (no model, default) | other engines once one is set up
ANTHROPIC_API_KEY=                # only if Velocity does not proxy model access
MODEL_AGENTS=claude-sonnet-5-5    # orchestrator and reasoning agents
MODEL_EXTRACTION=claude-haiku-5-5 # field extraction (lower cost)
MODEL_USAGE_CAP_PER_RUN=          # model calls are refused once a run reaches this cap (TC-004)
MODEL_MONTHLY_BUDGET_USD=300      # usage is logged per run and checked against this

# -----------------------------------------------------------------------------
# Database - PostgreSQL in a local container (ADR-002)
# Cases, package versions, approvals, mock stores and the INSERT-only audit log
# -----------------------------------------------------------------------------
DB_PORT=5432
DB_NAME=coworker
DB_ADMIN_PASSWORD=                # container admin; used only by scripts/apply_db.sh
DB_APP_PASSWORD=                  # password given to the coworker_app role
DB_AUDIT_PASSWORD=                # password given to the audit_writer role (INSERT only)
DATABASE_URL=postgresql://coworker_app:<DB_APP_PASSWORD>@127.0.0.1:5432/coworker
AUDIT_DATABASE_URL=postgresql://audit_writer:<DB_AUDIT_PASSWORD>@127.0.0.1:5432/coworker
SEED_DATA_PATH=./db/seed          # synthetic seed scenarios

# -----------------------------------------------------------------------------
# JobDiva - mock by default; sandbox is READ-ONLY and needs API credentials
# (Client ID from JobDiva support + dedicated API user). The web login does
# not work for the API. The Coworker never writes to JobDiva, in any mode: mock
# writes only to its own local synthetic store; sandbox is read-only (BR-014).
# Fixed at startup; any value other than mock or sandbox stops the server.
# -----------------------------------------------------------------------------
JOBDIVA_MODE=mock                 # mock | sandbox
JOBDIVA_BASE_URL=https://api.jobdiva.com   # API host, not login.jobdiva.com
JOBDIVA_CLIENT_ID=
JOBDIVA_API_USER=
JOBDIVA_API_PASSWORD=

# -----------------------------------------------------------------------------
# MCP servers (loopback addresses) - simulated systems, never real orders or access
# -----------------------------------------------------------------------------
JOBDIVA_MOCK_URL=http://127.0.0.1:8101        # JobDiva READ server
JOBDIVA_WORKFLOW_URL=http://127.0.0.1:8106    # JobDiva and Workflow server, the only one with write tools
IT_ACCESS_MOCK_URL=http://127.0.0.1:8102      # email, Teams and app access requests
EQUIPMENT_MOCK_URL=http://127.0.0.1:8103      # laptop requests (Chelsea Tech), IT approval
PAYROLL_MOCK_URL=http://127.0.0.1:8104        # payroll package and returns (Paychex)
LDC_TRACKER_MOCK_URL=http://127.0.0.1:8105    # IGS / LDC tracker (SharePoint list)
OUTLOOK_MOCK_URL=http://127.0.0.1:8107        # onboarding mailbox
TEAMS_MOCK_URL=http://127.0.0.1:8108          # alerts shown in the simulated alerts view
KNOWLEDGE_BASE_MOCK_URL=http://127.0.0.1:8109 # validated onboarding knowledge records

# -----------------------------------------------------------------------------
# Onboarding mailbox (start emails) - mock reads synthetic .eml files
# -----------------------------------------------------------------------------
MAILBOX_MODE=mock                 # mock | graph (graph is for the pilot only)
MAILBOX_MOCK_PATH=./db/seed/mailbox
MAILBOX_ADDRESS=                  # graph mode only (pilot)

# -----------------------------------------------------------------------------
# Microsoft 365 / Teams - always mock in the hackathon (TC-005: no Teams bot)
# The bot value and the variables below are reserved for the pilot.
# -----------------------------------------------------------------------------
TEAMS_MODE=mock                   # mock | bot (pilot only)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_PASSWORD=

# -----------------------------------------------------------------------------
# Governance
# -----------------------------------------------------------------------------
APPROVER_NAME="Tonya Ramirez"     # Consultant Onboarding Supervisor (demo approver)
REMINDER_MAX_PER_DAY=2            # cap on reminders to candidates or leaders

# -----------------------------------------------------------------------------
# Feature flags (Should / Could capabilities) - turn on after the MVP works
# -----------------------------------------------------------------------------
FEATURE_ACCESS_EQUIPMENT=false    # S1
FEATURE_CANDIDATE_FOLLOWUP=false  # S2, S3
FEATURE_PAYROLL_PACKAGE=false     # S4
FEATURE_KNOWLEDGE_BASE=false      # S5
FEATURE_IGS_HANDOFF=false         # C1, C2
