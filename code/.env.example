# =============================================================================
# Onboarding Digital Coworker - environment variables
# Copy this file to `code/.env` and fill in the values. Never commit `.env`.
# Values marked "mock" run the demo with synthetic data and no real systems.
# Every service binds to 127.0.0.1 only. See the tech doc, Section 4.3.
# =============================================================================

# -----------------------------------------------------------------------------
# Database - PostgreSQL in a local container (ADR-002). REQUIRED.
# Cases, package versions, approvals, mock stores and the INSERT-only audit log.
# Put the app and audit passwords inside the two URLs.
# -----------------------------------------------------------------------------
DB_PORT=5432
DB_NAME=coworker
DB_ADMIN_PASSWORD=                # container admin; used only by scripts/apply_db.sh
DB_APP_PASSWORD=                  # password given to the coworker_app role
DB_AUDIT_PASSWORD=                # password given to the audit_writer role (INSERT only)
DATABASE_URL=postgresql://coworker_app:<DB_APP_PASSWORD>@127.0.0.1:5432/coworker
AUDIT_DATABASE_URL=postgresql://audit_writer:<DB_AUDIT_PASSWORD>@127.0.0.1:5432/coworker

# -----------------------------------------------------------------------------
# How the demo runs
# -----------------------------------------------------------------------------
AGENT_TRANSPORT=mcp               # mcp (agents call the MCP servers) | in_process (fallback, same interfaces)
JOBDIVA_MODE=mock                 # mock | sandbox (read-only, needs the credentials below)
FEATURE_ACCESS_EQUIPMENT=true     # Should S1: laptop and access request, overhead, bill-back
WEB_APP_PORT=3000                 # local web app and API (chat, inbox, approval, alerts, status views)

# -----------------------------------------------------------------------------
# Model client (ADR-006). rules needs no model and no key; claude reads free text.
# -----------------------------------------------------------------------------
MODEL_PROVIDER=rules              # rules (no model, default) | claude (needs ANTHROPIC_API_KEY)
MODEL_USAGE_CAP_PER_RUN=50        # model calls are refused once a run reaches this cap (TC-004)
ANTHROPIC_API_KEY=                # claude only; never commit it, never log it
ANTHROPIC_WORKSPACE_ID=           # claude only, when the key is not scoped to a workspace
MODEL_EXTRACTION=claude-haiku-5-5 # claude only: reads start details (lower cost)

# -----------------------------------------------------------------------------
# MCP servers (loopback addresses), started by scripts/start.sh when AGENT_TRANSPORT=mcp
# -----------------------------------------------------------------------------
JOBDIVA_MOCK_URL=http://127.0.0.1:8101        # JobDiva READ server
JOBDIVA_WORKFLOW_URL=http://127.0.0.1:8106    # JobDiva and Workflow server, the only one with write tools
TEAMS_MOCK_URL=http://127.0.0.1:8108          # alerts shown in the simulated alerts view
KNOWLEDGE_BASE_MOCK_URL=http://127.0.0.1:8109 # onboarding knowledge records (US-025)
COWORKER_MCP_URL=http://127.0.0.1:8110        # the Coworker itself, for other chat apps (Claude, VS Code)
COWORKER_MCP_ROLE=recruiter                   # the role those apps act as; never approves or acts

# -----------------------------------------------------------------------------
# JobDiva sandbox - only for JOBDIVA_MODE=sandbox. READ-ONLY: the Coworker never
# writes to JobDiva, in any mode: mock writes only to its own local synthetic
# store; sandbox is read-only (BR-014). Needs a Client ID from JobDiva support
# and a dedicated API user; the web login does not work for the API.
# -----------------------------------------------------------------------------
JOBDIVA_BASE_URL=https://api.jobdiva.com   # API host, not login.jobdiva.com
JOBDIVA_CLIENT_ID=
JOBDIVA_API_USER=
JOBDIVA_API_PASSWORD=

# =============================================================================
# Reserved for the pilot - not read by the hackathon build. Kept so the names
# are agreed before the integrations land. Leave them commented out.
# =============================================================================
# VELOCITY_BASE_URL=              # Velocity 2.0 is the delivery method, not a runtime (ADR-006)
# VELOCITY_API_KEY=
# VELOCITY_PROJECT_ID=
# MODEL_AGENTS=claude-sonnet-5-5  # orchestrator and reasoning agents
# MODEL_MONTHLY_BUDGET_USD=300
# MAILBOX_MODE=mock               # mock | graph (Microsoft Graph mailbox)
# MAILBOX_ADDRESS=
# TEAMS_MODE=mock                 # mock | bot (TC-005: no Teams bot in the hackathon)
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# TEAMS_BOT_APP_ID=
# TEAMS_BOT_APP_PASSWORD=
# IT_ACCESS_MOCK_URL=http://127.0.0.1:8102      # Should agents' own MCP servers
# EQUIPMENT_MOCK_URL=http://127.0.0.1:8103
# PAYROLL_MOCK_URL=http://127.0.0.1:8104
# LDC_TRACKER_MOCK_URL=http://127.0.0.1:8105
# REMINDER_MAX_PER_DAY=2          # Candidate Follow-up
# FEATURE_CANDIDATE_FOLLOWUP=false    # S2, S3
# FEATURE_PAYROLL_PACKAGE=false       # S4
# FEATURE_IGS_HANDOFF=false           # C1, C2
